#!/usr/bin/env python3
"""Single development entry; chapter-specific scientific runtimes stay isolated."""
import argparse
import json
import os
from pathlib import Path
import sys

PROJECT = Path(os.environ.get("RESOURCE_ALLOCATION_PROJECT_ROOT",
                             "/root/gamewar/resource_allocation_rl")).resolve()
REGISTRY = PROJECT / "MAINTAINED_CODE.json"


def runtime():
    configured = os.environ.get("RESOURCE_ALLOCATION_PYTHON")
    setting = PROJECT / ".runtime-python"
    if not configured and setting.is_file():
        configured = setting.read_text().strip()
    return configured or sys.executable


def registry():
    return json.loads(REGISTRY.read_text())


def inspect(chapter=None):
    data = registry()
    if chapter:
        key = chapter if chapter.startswith("chapter") else "chapter" + chapter
        if key not in data["chapters"]:
            raise SystemExit("Unknown chapter: " + chapter)
        item = dict(data["chapters"][key])
        receipt = item.get("integration")
        if receipt:
            item["integration_receipt"] = json.loads((PROJECT / receipt).read_text())
        data = {key: item}
    print(json.dumps(data, ensure_ascii=False, indent=2))


def check():
    data = registry()
    errors = []
    for name, item in data["chapters"].items():
        for field in ("source", "entrypoint", "integration"):
            relative = item.get(field)
            if relative and not (PROJECT / relative).exists():
                errors.append(name + ": missing " + field + " " + relative)
    if data.get("chapter5_external_comparators") != []:
        errors.append("The retired chapter-five external roster must stay empty")
    print(json.dumps({"status": "PASS" if not errors else "FAIL", "errors": errors,
                      "chapters": len(data["chapters"]), "kind": "static_entrypoint_check",
                      "training_started": False, "scientific_imports": 0}, ensure_ascii=False, indent=2))
    if errors:
        raise SystemExit(1)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""Commands:
  inspect [2|3|4|5|6]     Show maintained source and its integration evidence
  check                 Check paths and registry without importing scientific packages
  chapter2 ...          Independent chapter02 method / baseline / ablation commands
  chapter3 ...          Independent chapter03 method / baseline / ablation commands
  chapter3-main ...     Compatibility alias for chapter3
  chapter4 ...          Full-spend chapter-four development entry
  chapter5 ...          Full and ablation development entry; external roster empty
  chapter6 ...          Irrigation environment and full-spend CPU deployment checks

No training or recovery is started by inspect/check or by omitting a command.
Training requires an explicit chapter command and its new output/configuration.
See docs/整合后使用说明_20261105.rst for the chapter-specific commands.""")
        parser.print_help()
        return
    command, rest = args[0], args[1:]
    if command == "inspect":
        if len(rest) > 1:
            raise SystemExit("Usage: ./project inspect [chapter]")
        inspect(rest[0] if rest else None)
        return
    if command == "check":
        if rest:
            raise SystemExit("check does not accept additional arguments")
        check()
        return
    # The chapter workspaces own their commands. Keep the old main-only spelling
    # as an alias; current chapter3 train defaults to its native method A.
    if command == "chapter3-main":
        command = "chapter3"
    data = registry()
    if command not in data["chapters"]:
        raise SystemExit("Unknown command: " + command)
    item = data["chapters"][command]
    entry = (PROJECT / item["entrypoint"]).resolve(strict=True)
    executable = "/bin/bash" if entry.suffix == ".sh" else runtime()
    env = os.environ.copy()
    env["RESOURCE_ALLOCATION_PROJECT_ROOT"] = str(PROJECT)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    # Each launcher supplies its own Python path and runtime. Importing a shared
    # allocation23 here would invalidate the separate chapter releases.
    env.pop("PYTHONPATH", None)
    os.execve(executable, [executable, str(entry), *(rest or ["inspect"])], env)


if __name__ == "__main__":
    main()
