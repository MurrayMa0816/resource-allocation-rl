#!/usr/bin/env python3
"""Current thesis code with one explicit, physical final-data directory."""
from pathlib import Path
import argparse, gzip, hashlib, json, os, stat, subprocess, sys

ROOT=Path(__file__).resolve().parent
from portable_paths import final_data_root, chapter_data_root
DATA=final_data_root()

def read_index():
    return json.loads((DATA/'INDEX.json').read_text())

def check(full=False):
    from release_tools import main as release_main
    return release_main(["check", "--require-data"])

def _archival_check_unused(full=False):
    d=json.loads(gzip.decompress((DATA/'registry/files.json.gz').read_bytes()))
    errors=[]; verified=0
    for row in d['files']:
        p=DATA/row['path']
        if not p.is_file():errors.append('missing: '+row['path']);continue
        s=p.lstat()
        if not stat.S_ISREG(s.st_mode) or s.st_nlink!=1:errors.append('not an independent regular file: '+row['path']);continue
        if s.st_size!=row['size']:errors.append('size: '+row['path']);continue
        if full:
            with p.open('rb') as f:actual=hashlib.file_digest(f,'sha256').hexdigest()
            if actual!=row['sha256']:errors.append('SHA: '+row['path']);continue
        verified+=1
    for base,ds,fs in os.walk(DATA,followlinks=False):
        for n in ds+fs:
            p=Path(base)/n
            if p.is_symlink():errors.append('symbolic link: '+str(p.relative_to(DATA)))
    result={'status':'PASS' if not errors else 'FAIL','data_root':str(DATA),'verified_files':verified,
            'hashes_verified':full,'errors':errors,'scientific_execution':0}
    print(json.dumps(result,ensure_ascii=False,indent=2))
    return 0 if not errors else 1

def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('command',nargs='?',default='inspect',choices=['inspect','check','experiments','path','redraw','chapter2','chapter3','chapter4','chapter5','chapter6'])
    p.add_argument('args',nargs=argparse.REMAINDER)
    a=p.parse_args();cmd=a.command;args=a.args
    if cmd=='check':return check('--hash' in args)
    if cmd in ('inspect','experiments'):
        d=read_index()
        if args:
            key='chapter'+args[0].removeprefix('chapter').zfill(2)
            d=d['chapters'][key]
        print(json.dumps(d,ensure_ascii=False,indent=2));return 0
    if cmd=='path':
        chap='chapter'+args[0].removeprefix('chapter').zfill(2)
        print(chapter_data_root(chap));return 0
    if cmd=='redraw':
        if not args:raise SystemExit('Usage: project redraw CHAPTER [FIGURE_DIRECTORY]')
        chap='chapter'+args[0].removeprefix('chapter').zfill(2)
        figures=chapter_data_root(chap)/'figures'
        choices=[q for q in sorted(figures.iterdir()) if (q/'plot.py').is_file()]
        if len(args)>1:choices=[q for q in choices if q.name==args[1]]
        if not choices:raise SystemExit('No matching scientific figure')
        output=DATA/'replot_outputs'/chap
        env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1','MPLBACKEND':'Agg'}
        for q in choices:
            subprocess.run([sys.executable,str(q/'plot.py'),'--output-dir',str(output/q.name)],check=True,env=env)
        return 0
    number=int(cmd[-1]);entry=ROOT/'chapters'/('chapter%02d'%number)/'launcher.py'
    env={**os.environ,'RESOURCE_ALLOCATION_PROJECT_ROOT':str(ROOT),'RESOURCE_ALLOCATION_DATA_ROOT':str(DATA),
         'FINAL_DATA_ROOT':str(DATA),'PYTHONDONTWRITEBYTECODE':'1'}
    env['PYTHONPATH']=str(ROOT)
    os.execve(sys.executable,[sys.executable,str(entry),*(args or ['inspect'])],env)

if __name__=='__main__':raise SystemExit(main())
