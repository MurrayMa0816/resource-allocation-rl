        },
        {
          "id": "frozen",
          "before": "<div style=\"line-height:1.35;white-space:nowrap;\">冻结双价值预测</div><div style=\"line-height:1.35;white-space:nowrap;\"><span style=\"font-family:Times New Roman;\">\\(\\boldsymbol V_t=\\boldsymbol V_{\\psi_{\\rm old}}(s_t,\\lambda)\\)</span></div>",
