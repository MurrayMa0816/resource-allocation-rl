        </mxCell>
        <mxCell id="fitJ" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;成效网络独立拟合&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\(V_{\psi_J}\leftarrow y_t^J\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=4;strokeColor=none;strokeWidth=1.2;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#285F8A;" vertex="1" parent="1">
          <mxGeometry x="158" y="302" width="124" height="60" as="geometry" />
        </mxCell>
        <mxCell id="adv" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;下一时刻目标与当前预测作差&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\(\boldsymbol A_t=\boldsymbol y_{t+1}-\boldsymbol V_t\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;strokeColor=#000000;strokeWidth=0.8;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="306" y="302" width="268" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mix" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;原始优势按偏好加权&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\(A_t^\lambda=\lambda A_t^C+(1-\lambda)A_t^J\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#263445;align=center;verticalAlign=middle;spacing=4;strokeColor=none;strokeWidth=1.0;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#BDD5EB;" vertex="1" parent="1">
