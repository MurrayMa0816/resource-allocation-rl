  <diagram id="fig-5-3" name="图5.3 双价值目标与统一策略优势的计算">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="592" pageHeight="580" math="1" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="records" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;采集时轨迹记录与终点反馈&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\((s_t,\boldsymbol z_t,\lambda,\mu;C,J)\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#263445;align=center;verticalAlign=middle;spacing=4;strokeColor=none;strokeWidth=0.8;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#E3EDE2;" vertex="1" parent="1">
          <mxGeometry x="163" y="8" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rho" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;共用密度校正&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\(\rho_t\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;strokeColor=#000000;strokeWidth=0.8;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="14" y="102" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;真实终点边界&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\(\boldsymbol y_T=(C,J)^\top\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#263445;align=center;verticalAlign=middle;spacing=4;strokeColor=none;strokeWidth=0.8;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#E3EDE2;" vertex="1" parent="1">
          <mxGeometry x="208" y="102" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="frozen" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;批前固定价值预测&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\(\boldsymbol V_t=\boldsymbol V_{\psi_{\rm old}}(s_t,\lambda)\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;strokeColor=#000000;strokeWidth=0.8;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="402" y="102" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="trace" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;分项目标逆序回溯&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\(\boldsymbol y_t=(1-\rho_t)\boldsymbol V_t+\rho_t\boldsymbol y_{t+1}\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;strokeColor=#000000;strokeWidth=0.8;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="129" y="202" width="328" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fitC" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;覆盖网络独立拟合&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\(V_{\psi_C}\leftarrow y_t^C\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=4;strokeColor=none;strokeWidth=1.2;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#285F8A;" vertex="1" parent="1">
