        {
          "id": "adv",
          "before": "<div style=\"line-height:1.35;white-space:nowrap;\">后继目标形成分项优势</div><div style=\"line-height:1.35;white-space:nowrap;\"><span style=\"font-family:Times New Roman;\">\\(\\boldsymbol A_t=\\boldsymbol y_{t+1}-\\boldsymbol V_t\\)</span></div>",
