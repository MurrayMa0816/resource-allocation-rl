<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" type="device" compressed="false">
  <diagram id="fig-2.3" name="基函数组合与共同偏移投影">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="592" pageHeight="760" math="1" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f2_3_objects" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;资源分配对象&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;的局部输入&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(\boldsymbol u_{i,t}\) \(i=1,\ldots,N\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#263445;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#F1D9B5;strokeColor=none;strokeWidth=0.8;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="112" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2_3_norm" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;逐列标准化&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(\begin{gathered}Z_t=\operatorname{Norm}\\([\boldsymbol u_{i,t}^{\mathsf T}]_{i=1}^N)\end{gathered}\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=0.8;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="138" y="12" width="112" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2_3_basis" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;六个固定基函数&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(\boldsymbol F_t=\operatorname{Norm}([f_1(Z_t),\ldots,f_6(Z_t)])\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=0.8;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="276" y="12" width="298" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2_3_weights" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;策略组合系数&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(\boldsymbol w_t\in\mathbb R^{d_w}\)&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(d_w=6d_x\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=0.8;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="12" y="132" width="112" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2_3_score" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;组合并中心化&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(\boldsymbol b_t=\boldsymbol F_t\boldsymbol w_t\)&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(d_{i,t}=b_{i,t}-b_{\mathrm{mean},t}\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#285F8A;strokeColor=none;strokeWidth=1.2;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="144" y="132" width="144" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2_3_candidate" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;候选配置&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(v_{i,t}=\frac{q_t}{N}(1+d_{i,t})\)&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(\sum_i v_{i,t}=q_t\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=0.8;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="308" y="132" width="154" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2_3_quota" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;当期资源&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;分配总量&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(q_t\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=0.8;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="482" y="132" width="92" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2_3_caps" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;各对象的&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;资源分配量上限&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(c_{i,t}\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=0.8;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="12" y="252" width="136" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2_3_projection" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;共同偏移投影&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(a_{i,t}=\min\{c_{i,t},\max\{0,v_{i,t}-c_t^{\mathrm{proj}}\}\}\)&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(\sum_i a_{i,t}=q_t\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#263445;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#BDD5EB;strokeColor=none;strokeWidth=1.0;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="174" y="252" width="284" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2_3_action" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;各对象实际&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;资源分配量&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(\boldsymbol a_t\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#263445;align=center;verticalAlign=middle;spacing=4;overflow=visible;autosize=0;fillColor=#E3EDE2;strokeColor=none;strokeWidth=0.8;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="484" y="252" width="90" height="80" as="geometry" />
        </mxCell>
