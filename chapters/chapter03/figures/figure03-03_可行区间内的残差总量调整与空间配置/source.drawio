        </mxCell>
        <mxCell id="reference" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;参照总量&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(q_t^{\mathrm{ref}}=\operatorname{clip}(\frac{R_t}{T-t},L_t,U_t)\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;spacing=4;strokeColor=#000000;strokeWidth=0.8;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#FFFFFF;" vertex="1" parent="1">
