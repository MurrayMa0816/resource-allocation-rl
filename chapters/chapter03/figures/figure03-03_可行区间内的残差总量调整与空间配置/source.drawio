        <mxCell id="interval" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;执行区间&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\([L_t,U_t]\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#263445;align=center;verticalAlign=middle;spacing=4;strokeColor=none;strokeWidth=0.8;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#F1D9B5;" vertex="1" parent="1">
