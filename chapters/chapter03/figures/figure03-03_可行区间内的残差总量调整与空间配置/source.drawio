  <diagram id="fig-3.3" name="可行区间内的残差总量调整与对象间分配">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="592" pageHeight="600" math="1" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
