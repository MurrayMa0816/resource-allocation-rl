        </mxCell>
        <mxCell id="boundary" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;端点或退化时&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;端点采用单侧调整&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;\(L_t=U_t\ \Rightarrow\ q_t=L_t\)&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=4;strokeColor=none;strokeWidth=1.2;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#285F8A;" vertex="1" parent="1">
