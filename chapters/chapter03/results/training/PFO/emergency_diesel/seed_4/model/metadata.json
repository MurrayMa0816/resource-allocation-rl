{
  "method": "pfo",
  "paper": "No Representation, No Trust (NeurIPS2024)",
  "config": {
    "horizon": 24,
    "actor_architecture": "shared_mean",
    "rollout_steps": 512,
    "total_steps": 100608,
    "epochs": 10,
    "minibatches": 8,
    "gamma": 0.99,
    "gae_lambda": 1.0,
    "epsilon": 0.2,
    "learning_rate": 0.0003,
    "learning_rate_decay": false,
    "value_coefficient": 0.5,
    "entropy_coefficient": 0.0,
    "max_grad_norm": 0.5,
    "reward_scale": 1.0,
    "normalize_observation": false,
    "normalize_reward": false,
    "normalization_clip": 10.0,
    "adam_epsilon": 1e-08,
    "pfo_coefficient": 1.0,
    "feature_scope": "heads_penultimate",
    "policy_distribution": "tanh_state_dependent_scale"
  },
  "evaluation_only": true,
  "optimizer_or_replay_saved": false,
  "critic_saved": false,
  "distribution": "TanhNormal with state-dependent scale",
  "feature_scope": "actual two shared mean+scale head penultimate preactivations; equal head weighting"
}
