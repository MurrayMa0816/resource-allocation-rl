#!/bin/sh
# One active package plus the preserved irrigation application.
project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
runtime=${RESOURCE_ALLOCATION_PYTHON:-}
if [ -z "$runtime" ] && [ -f "$project_root/.runtime-python" ]; then
    IFS= read -r runtime < "$project_root/.runtime-python"
fi
if [ -z "$runtime" ]; then
    runtime=$(command -v python3) || exit 127
fi
if [ ! -x "$runtime" ]; then
    printf '%s\n' 'Configured Python runtime is unavailable.' >&2
    exit 127
fi
PYTHONPATH="$project_root:$project_root/applications/irrigation/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
exec "$runtime" "$@"
