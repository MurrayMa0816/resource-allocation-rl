        <mxCell id="records" value="&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;完整轨迹记录&lt;/div&gt;&lt;div style=&quot;line-height:1.35;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;\(s_t,\ \boldsymbol z_t,\ \log\mu,\ F_T\)&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fontFamily=Times New Roman,SimSun;fontSize=14;fontStyle=0;fontColor=#263445;align=center;verticalAlign=middle;spacing=6;fillColor=#E3EDE2;strokeColor=none;strokeWidth=0.8;overflow=visible;autosize=0;rounded=1;absoluteArcSize=1;arcSize=5;" vertex="1" parent="1">
